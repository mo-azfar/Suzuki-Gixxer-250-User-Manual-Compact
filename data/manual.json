        {
            "id": "adjustment",
            "title": "Adjustment",
            "summary": "adjusting headlight beam, body parts removal",
            "applicable_models": [
                "Gixxer 250"
            ],
            "blocks": [
                {
                    "type": "sections"
                }
            ],
            "sections": [
                {
                    "heading": "1. Headlight Beam Adjustment",
                    "bullets": [
                        "Loose the headlight beam adjuster bolt (1) on the left hand side of the headlight assembly.",
                        "Move headlight up or down to adjust the beam",
                        "Tight the headlight beam adjuster bolt (1) to secure the position [IMG#img3]"
                    ]
                },
                {
                    "heading": "2. Seat Lock Removal",
                    "bullets": [
                        "Insert the key into the seat lock and turn it clockwise to unlock the seat.",
                        "Raise the front part of the seat and slide it forward. [IMG#img4]"
                    ]
                },
                {
                    "heading": "3. Front Seat Removal",
                    "bullets": [
                        "Remove seat lock.",
                        "Remove the two bolts (1) securing the front seat.",
                        "Lift the rear part of the front seat and slide it backward to remove. [IMG#img5]"
                    ]
                },
                {
                    "heading": "4. Left Frame Cover Removal",
                    "bullets": [
                        "Remove seat lock and front seat.",
                        "Remove 3 bolts (green) securing the left frame cover.",
                        "Remove 1 fastener clip (blue) securing the left frame cover. [IMG#img6]",
                        "Unhook the hook and remove the left frame cover. [IMG#img7]"
                    ]
                },
                {
                    "heading": "5. Right Frame Cover Removal",
                    "bullets": [
                        "Remove seat lock and front seat.",
                        "Remove 3 bolts (green) securing the right frame cover.",
                        "Remove 1 fastener clip (blue) securing the right frame cover. [IMG#img8]"
                    ]
                },
                {
                    "heading": "6. Battery Removal",
                    "bullets": [
                        "Remove seat lock, front seat and left frame cover.",
                        "Disconnect the negative terminal first, then disconnect the positive terminal.",
                        "Remove battery band (1) and bolt (2). [IMG#img9]",
                        "Pull the rear frame cover (3) and pull out the battery. [IMG#img10]"
                    ]
                },
                {
                    "heading": "7. Air Filter Removal",
                    "bullets": [
                        "Remove seat lock, front seat and left frame cover.",
                        "Remove the screws and air cleaner cap (1). [IMG#img11]",
                        "Pull out the air filter element and replace if necessary. [IMG#img12]"
                    ]
                }
            ]
        },
