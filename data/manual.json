        {
            "id": "meter-instrument-panel",
            "title": "Meter / Instrument Panel",
            "summary": "",
            "applicable_models": [
                "Gixxer 250"
            ],
            "blocks": [
                {
                    "type": "sections"
                }
            ],
            "sections": [
                {
                    "heading": "Meter / Instrument Panel Overview",
                    "bullets": [
                        "[INLINEIMG#img16]"
                    ]
                },
                {
                    "heading": "Odomoter / Trip Meter (14)",
                    "bullets": [
                        "The display meter can be toggled between odometer, trip meter A and trip meter B by pressing the SEL button (1). [IMG#img17]",
                        "To reset trip meter A or B, push the ADJ button (2) for 2 seconds while the desired trip meter is displayed."
                    ]
                },
                {
                    "heading": "Reset Oil Change Indicator (12)",
                    "bullets": [
                        "Turn off the ignition switch.",
                        "Press and hold SEL button (1) and turn on ignition switch. Keep holding the SEL button (1) for 4 seconds",
                        "The oil change counter will reset and the oil change indicator will blink 3 times and then turn off.",
                        "NOTE: The factory preset interval is 5000 km."
                    ]
                },
                {
                    "heading": "Preset Oil Change Interval Indicator (12)",
                    "bullets": [
                        "Set the meter to odometer, then press and hold the ADJ button (2) for 2 seconds until the interval and oil change indicator start blinking.",
                        "Push the SEL button (1) to decrease the interval from 5000 km to 500 km.",
                        "Push the ADJ button (2) to increase the interval from 500 km to 5000 km.",
                        "To exit the preset mode, press and hold the SEL button (1) AND ADJ button (2) for 2 seconds."
                    ]
                },
                {
                    "heading": "Clock Adjustment (15)",
                    "bullets": [
                        "Press and hold the SEL button (1) AND ADJ button (2) simultaneously for 2 seconds to enter clock adjustment mode. The hour and minute digits will start blinking.",
                        "Push the SEL button (1) to adjust the hour.",
                        "Push the ADJ button (2) to adjust the minute.",
                        "To exit the clock adjustment mode, press and hold the SEL button (1) AND ADJ button (2) simultaneously for 2 seconds."
                    ]
                }
            ]
        },
