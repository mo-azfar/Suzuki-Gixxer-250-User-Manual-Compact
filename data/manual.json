                {
                    "label": "20A MAIN Fuse",
                    "value": "Protects all electrical circuits"
                },
                {
                    "label": "15A SUB Fuse",
                    "value": "Protect fuel indicator, oxygen sensor, solenoid, fuel pump, ignition coil, headlight, position light, license plate light, taillight, stop light, turn signal light, horn, speedometer, horn, starter relay, starter sub relay, ECM and ABS"
                },
                {
                    "label": "10A SIGNAL Fuse",
                    "value": "Protects speedometer, turn signal light, stop light, taillight, license plate light, position light and headlight beams."
                },
                {
                    "label": "10A FAN Fuse",
                    "value": "Protects the cooling fan relay"
                },
                {
                    "label": "10A ABS-M Fuse",
                    "value": "Protects the ABS system"
                },
                {
                    "label": "10A ABS-V Fuse",
                    "value": "Protects the ABS system"
                }
            ]
